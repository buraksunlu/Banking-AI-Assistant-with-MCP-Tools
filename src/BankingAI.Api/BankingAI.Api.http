@BankingAI.Api_HostAddress = http://localhost:5248

GET {{BankingAI.Api_HostAddress}}/api/health
Accept: application/json

###

# Login. Put your own demo password here only locally; never commit it.
# @name login
POST {{BankingAI.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "username": "ada",
  "password": "<your-local-demo-password>"
}

###

GET {{BankingAI.Api_HostAddress}}/api/me
Authorization: Bearer {{login.response.body.$.token}}
Accept: application/json

###
