@BankingAI.Api_HostAddress = http://localhost:5248

GET {{BankingAI.Api_HostAddress}}/api/health
Accept: application/json

###

# Login. Put your own demo password here only locally; never commit it.
# @name login
POST {{BankingAI.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "username": "ada",
  "password": "<your-local-demo-password>"
}

###

GET {{BankingAI.Api_HostAddress}}/api/me
Authorization: Bearer {{login.response.body.$.token}}
Accept: application/json

###

GET {{BankingAI.Api_HostAddress}}/api/accounts
Authorization: Bearer {{login.response.body.$.token}}
Accept: application/json

###

GET {{BankingAI.Api_HostAddress}}/api/accounts/20000000-0000-0000-0000-000000000001
Authorization: Bearer {{login.response.body.$.token}}
Accept: application/json

###

# Opens a real account for the logged-in customer (writes to the database).
POST {{BankingAI.Api_HostAddress}}/api/accounts
Authorization: Bearer {{login.response.body.$.token}}
Content-Type: application/json

{
  "accountName": "Tatil birikimi",
  "currencyCode": "EUR"
}

###
