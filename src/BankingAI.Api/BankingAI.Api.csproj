<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- XML comments become the OpenAPI summaries and descriptions (API-15). Public types and methods carry a summary by
         convention; members without one (record parameters) are not warned about. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.13" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared setup with the MCP server (token validation, business time, JSON rules); brings Application with it. -->
    <ProjectReference Include="../BankingAI.Hosting/BankingAI.Hosting.csproj" />
  </ItemGroup>

</Project>
