<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- XML comments become the OpenAPI summaries and descriptions (API-15). Public types and methods carry a summary by
         convention; members without one (record parameters) are not warned about. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../BankingAI.Data/BankingAI.Data.csproj" />
  </ItemGroup>
</Project>
