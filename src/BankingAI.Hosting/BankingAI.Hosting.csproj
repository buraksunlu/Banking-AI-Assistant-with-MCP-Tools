<Project Sdk="Microsoft.NET.Sdk">

  <!-- What the API and the MCP server share (MCP-a, decision K8-A): token validation, business time, the JSON rules and
       the read-only service registrations, so a security or time rule exists exactly once. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../BankingAI.Application/BankingAI.Application.csproj" />
  </ItemGroup>

</Project>
