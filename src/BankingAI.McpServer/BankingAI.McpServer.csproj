<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The read-only MCP server the AI service calls for figures (MCP-a). A separate process from the API (decision K1-A):
       the model's door never shares a program with the phone's door, and it listens on 127.0.0.1 only. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../BankingAI.Hosting/BankingAI.Hosting.csproj" />
  </ItemGroup>

</Project>
