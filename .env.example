# Local PostgreSQL connection. Copy to .env and set the password.
BANKINGAI_CONNECTION_STRING='Host=127.0.0.1;Port=55432;Database=bankingai_foundation;Username=bankingai_foundation;Password=replace-with-local-password;Include Error Detail=false'

# Demo login passwords (SEC-01a). Generate your own random values; never commit real ones.
# Apply with: dotnet run --project src/BankingAI.Cli -- users set-password <username> [--customer <customer-id>]
BANKINGAI_DEMO_PASSWORD_ADA=
BANKINGAI_DEMO_PASSWORD_DENIZ=
BANKINGAI_DEMO_PASSWORD_EGE=

# API token signing key (SEC-01b): at least 32 bytes of random data, e.g. `openssl rand -base64 48`.
# The API refuses to start without it. Never commit a real value.
BANKINGAI_JWT_SIGNING_KEY=

# Local AI (AI-01). Model name used by ai/model_check/run.py when --model is not given, and later by the AI service.
BANKINGAI_LLM_MODEL=qwen3.5:4b
# Optional: Ollama address (default http://127.0.0.1:11434).
BANKINGAI_OLLAMA_URL=
